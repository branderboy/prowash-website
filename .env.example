# Neon Postgres
DATABASE_URL=postgres://user:pass@host/db

# Auth: HMAC over the os_auth cookie payload. Generate with: openssl rand -hex 32
OS_AUTH_SECRET=change-me-32-bytes-hex

# Admin endpoints (POST /api/admin/setup, /api/admin/seed-prowash)
ADMIN_SETUP_TOKEN=change-me

# Prowash seed (used by /api/admin/seed-prowash)
PROWASH_OWNER_EMAIL=owner@prowashdetail.net
PROWASH_OWNER_NAME=Prowash Owner
PROWASH_OWNER_PASSWORD=set-a-strong-password
PROWASH_PRIMARY_HOST=prowashdetail.net
