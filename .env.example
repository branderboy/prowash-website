# Neon Postgres
DATABASE_URL=postgres://user:pass@host/db

# Auth (HMAC over user_id:client_id:exp). Generate with: openssl rand -hex 32
OS_AUTH_SECRET=change-me-32-bytes-hex

# Magic link settings
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
MAGIC_LINK_FROM="Tagglefish <noreply@tagglefish.com>"

# Admin setup endpoints (POST /api/admin/setup, /api/admin/seed-prowash)
ADMIN_SETUP_TOKEN=change-me

# Prowash seed
PROWASH_OWNER_EMAIL=owner@prowash.com
PROWASH_OWNER_NAME=Prowash Owner
PROWASH_PRIMARY_HOST=prowash.com
